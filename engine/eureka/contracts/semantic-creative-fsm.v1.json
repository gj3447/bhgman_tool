          "candidate_hash": {"type": "string"},
          "receipt_hash": {"type": "string"}
        }
      }
    },
    "RecordLocalProposal": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["run_id", "candidate_hash", "proposal_hash"],
        "properties": {
          "run_id": {"type": "string"},
          "candidate_hash": {"type": "string"},
          "proposal_hash": {"type": "string"}
        }
      }
    },
    "RequestReleaseApproval": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["run_id", "proposal_hash", "destination_hash"],
        "properties": {
          "run_id": {"type": "string"},
          "proposal_hash": {"type": "string"},
          "destination_hash": {"type": "string"}
        }
      }
    },
    "PublishProposedBundle": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["run_id", "proposal_hash", "destination_hash", "idempotency_key"],
        "properties": {
          "run_id": {"type": "string"},
          "proposal_hash": {"type": "string"},
          "destination_hash": {"type": "string"},
          "idempotency_key": {"type": "string"}
        }
      }
    },
    "ReconcileProposalRelease": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["run_id", "proposal_hash", "destination_hash", "attempt_hash"],
        "properties": {
          "run_id": {"type": "string"},
          "proposal_hash": {"type": "string"},
          "destination_hash": {"type": "string"},
          "attempt_hash": {"type": "string"}
        }
      }
    },
    "RecordPendingInterrupt": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["run_id", "interrupt_type", "event_id"],
        "properties": {
          "run_id": {"type": "string"},
          "interrupt_type": {"type": "string"},
          "event_id": {"type": "string"}
        }
      }
    },
    "AuditInvalidTransition": {
      "kind": "audit",
      "payload_schema": {
        "type": "object",
        "required": ["state", "event", "actor", "reason", "event_id"],
        "properties": {
          "state": {"type": "string"},
          "event": {"type": "string"},
          "actor": {"type": "actor-id"},
          "reason": {"type": "string"},
          "event_id": {"type": "string"}
        }
      }
    }
  },
  "machines": [
    {
      "id": "creative-lifecycle",
      "initial": "INIT",
      "states": [
        {"id": "INIT", "kind": "atomic"},
        {"id": "DETECT", "kind": "atomic"},
        {"id": "ASSOCIATE", "kind": "atomic"},
        {"id": "DIVERGE", "kind": "atomic"},
        {"id": "COMPRESS", "kind": "atomic"},
        {"id": "FALSIFY", "kind": "atomic"},
        {"id": "REVISE", "kind": "atomic"},
        {"id": "READY_TO_PROPOSE", "kind": "atomic"},
        {"id": "WAIT_RELEASE_APPROVAL", "kind": "atomic"},
        {"id": "RELEASE_INTENT", "kind": "atomic"},
        {"id": "RELEASE", "kind": "atomic"},
        {"id": "RECONCILE_RELEASE", "kind": "atomic"},
        {"id": "HUMAN_RECONCILIATION", "kind": "atomic"},
        {"id": "HONOR_PENDING_INTERRUPT", "kind": "atomic"},
        {"id": "PROPOSED", "kind": "final"},
        {"id": "REJECTED", "kind": "final"},
        {"id": "PLATEAU", "kind": "final"},
        {"id": "RETRY_EXHAUSTED", "kind": "final"},
        {"id": "BUDGET_EXHAUSTED", "kind": "final"},
        {"id": "TIMED_OUT", "kind": "final"},
        {"id": "CANCELED", "kind": "final"}
      ],
      "events": [
        "START",
        "PATTERNS_READY",
        "ASSOCIATIONS_READY",
        "CANDIDATES_READY",
        "COMPRESSION_COMPLETED",
        "EVALUATION_RECORDED",
        "REVISION_READY",
        "PLATEAU",
        "RETRIES_EXHAUSTED",
        "RETURN_LOCAL_PROPOSAL",
        "EXTERNAL_RELEASE_REQUESTED",
        "APPROVED",
        "INTENT_COMMITTED",
        "ATTEMPT_RECORDED",
        "RECEIPT_CONFIRMED",
        "OUTCOME_UNKNOWN",
        "ABANDON",
        "NO_PENDING_INTERRUPT_SUCCESS",
        "NO_PENDING_INTERRUPT_FAILURE",
        "PENDING_CANCEL",
        "PENDING_TIMEOUT",
        "PENDING_BUDGET_EXHAUSTED",
        "CANCEL",
        "TIMEOUT",
        "BUDGET_EXHAUSTED"
      ],
      "invalid_event_policy": {
        "mode": "reject-and-audit",
        "guard_false": "reject-and-audit",
        "state_change": "none",
        "effect": "AuditInvalidTransition",
        "effect_binding": {
          "state": "configuration.state",
          "event": "event.type",
          "actor": "event.actor",
          "reason": "rejection.reason",
          "event_id": "event.event_id"
        }
      },
      "transitions": [
        {
          "id": "start-detection",
          "from": "INIT",
          "event": "START",
          "to": "DETECT",
          "effects": ["RequestPatternDetection"],
          "effect_bindings": {
            "RequestPatternDetection": {
              "run_id": "event.run_id",
              "event_id": "event.event_id"
            }
          }
        },
        {
          "id": "patterns-to-association",
          "from": "DETECT",
          "event": "PATTERNS_READY",
          "to": "ASSOCIATE",
          "effects": ["RequestAssociations"],
          "effect_bindings": {
            "RequestAssociations": {
              "run_id": "event.run_id",
              "evidence_hash": "event.evidence_hash"
            }
          }
        },
        {
          "id": "associations-to-divergence",
          "from": "ASSOCIATE",
          "event": "ASSOCIATIONS_READY",
          "to": "DIVERGE",
          "effects": ["RequestCandidateGeneration"],
          "effect_bindings": {
            "RequestCandidateGeneration": {
              "run_id": "event.run_id",
              "association_hash": "event.association_hash"
            }
          }
        },
        {
          "id": "divergence-to-compression",
          "from": "DIVERGE",
          "event": "CANDIDATES_READY",
          "to": "COMPRESS",
          "effects": []
        },
        {
          "id": "compression-to-falsification",
          "from": "COMPRESS",
          "event": "COMPRESSION_COMPLETED",
          "to": "FALSIFY",
          "effects": ["RequestIndependentEvaluation"],
          "effect_bindings": {
            "RequestIndependentEvaluation": {
              "run_id": "event.run_id",
              "candidate_hash": "event.candidate_hash",
              "evidence_hash": "event.evidence_hash"
            }
          }
        },
        {
          "id": "evaluation-pass",
          "from": "FALSIFY",
          "event": "EVALUATION_RECORDED",
          "to": "READY_TO_PROPOSE",
          "guard": "evaluation_passes",
          "priority": 30,
          "effects": []
        },
        {
          "id": "evaluation-revise",
          "from": "FALSIFY",
          "event": "EVALUATION_RECORDED",
          "to": "REVISE",
          "guard": "evaluation_correctable",
          "priority": 20,
          "effects": ["RequestRevision"],
          "effect_bindings": {
            "RequestRevision": {
              "run_id": "event.run_id",
              "candidate_hash": "event.candidate_hash",
              "receipt_hash": "event.receipt_hash"
            }
          }
        },
        {
          "id": "evaluation-reject-default",
          "from": "FALSIFY",
          "event": "EVALUATION_RECORDED",
          "to": "REJECTED",
          "priority": 10,
          "effects": []
        },
        {
          "id": "revision-to-falsification",
          "from": "REVISE",
          "event": "REVISION_READY",
          "to": "FALSIFY",
          "effects": ["RequestIndependentEvaluation"],
          "effect_bindings": {
            "RequestIndependentEvaluation": {
              "run_id": "event.run_id",
              "candidate_hash": "event.candidate_hash",
              "evidence_hash": "event.evidence_hash"
            }
          }
        },
        {
          "id": "revision-plateau",
          "from": "REVISE",
          "event": "PLATEAU",
          "to": "PLATEAU",
          "effects": []
        },
        {
          "id": "revision-retries-exhausted",
          "from": "REVISE",
          "event": "RETRIES_EXHAUSTED",
          "to": "RETRY_EXHAUSTED",
          "effects": []
        },
        {
          "id": "return-local-proposal",
