{
  "schema_version": "fsm-spec/v1",
  "name": "eureka-semantic-creative-lifecycle",
  "implementation_status": {
    "status": "DESIGN_TARGET",
    "current_slice": "creative.py in-memory inner loop; not yet reducer-conformant",
    "designed_only": [
      "typed command/event reducer",
      "durable interrupts",
      "release approval and reconciliation",
      "trace-fixture conformance",
      "crash replay"
    ]
  },
  "execution": {
    "step_interface": "step(versioned_configuration, typed_event) -> next_configuration, typed_effect_commands",
    "event_queue": "External observations are FIFO per run_id; recorded internal verdict events follow their causative event, and effect responses never re-enter synchronously.",
    "run_to_completion": "One event is validated, guards are evaluated from immutable configuration and payload, one transition is selected by stable priority, context is reduced, and commands are emitted before the next event.",
    "action_order": "Validate schema and expected version; evaluate pure guards; select transition; compute bounded context and budget delta; commit the transition; then emit typed effect commands."
  },
  "context_schema": {
    "run_id": {
      "type": "string"
    },
    "producer_id": {
      "type": "actor-id"
    },
    "current_candidate_hash": {
      "type": "string"
    },
    "current_evidence_hash": {
      "type": "string"
    },
    "correction_round": {
      "type": "non-negative integer"
    },
    "max_correction_rounds": {
      "type": "positive integer"
    },
    "steps_remaining": {
      "type": "non-negative integer"
    },
    "run_deadline": {
      "type": "timestamp",
      "role": "deadline"
    },
    "pending_interrupt": {
      "type": "string"
    }
  },
  "context_reduction": {
    "authority": "The deterministic reducer is the only writer of extended context; effects return typed observations and cannot mutate it directly.",
    "bounds": "correction_round is bounded by max_correction_rounds, steps_remaining is monotonic, hashes are fixed-width content addresses, and pending_interrupt is one of none, cancel, timeout, or budget_exhausted.",
    "recording": "Clock, random, identifier, model, retrieval, evaluator, and release-port values are committed as event payloads before later guards may read them."
  },
  "event_schemas": {
    "START": {
      "type": "object",
      "required": ["run_id", "actor", "event_id"],
      "properties": {
        "run_id": {"type": "string"},
        "actor": {"type": "actor-id"},
        "event_id": {"type": "string"}
