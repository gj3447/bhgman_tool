  "guards": {
    "evaluation_passes": {
      "reads": ["producer_id", "current_candidate_hash", "current_evidence_hash", "steps_remaining"],
      "event_reads": ["producer_id", "evaluator_id", "candidate_hash", "evidence_hash", "receipt_hash", "verdict"],
      "pure": true,
      "synchronous": true,
      "semantics": "True only when candidate and evidence hashes match context, evaluator identity and configured independence family differ from producer, verdict is pass, deterministic gates pass, receipt content hash and versions verify, and steps remain."
    },
    "evaluation_correctable": {
      "reads": ["producer_id", "current_candidate_hash", "current_evidence_hash", "correction_round", "max_correction_rounds", "steps_remaining"],
      "event_reads": ["producer_id", "evaluator_id", "candidate_hash", "evidence_hash", "receipt_hash", "verdict"],
      "pure": true,
      "synchronous": true,
      "semantics": "True only when all identity and hash bindings verify, verdict is revise, no terminal deterministic falsifier fired, correction and step budgets remain, and this semantic fingerprint has not plateaued."
    },
    "run_timeout_due": {
      "kind": "deadline",
      "deadline_context_field": "run_deadline",
      "observed_event_field": "observed_at",
      "reads": ["run_deadline"],
      "event_reads": ["observed_at"],
      "pure": true,
      "synchronous": true,
      "semantics": "True when observed_at is greater than or equal to the configured run_deadline and the event deadline matches the recorded deadline."
    }
  },
  "effects": {
    "RequestPatternDetection": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["run_id", "event_id"],
        "properties": {
          "run_id": {"type": "string"},
          "event_id": {"type": "string"}
        }
      }
    },
    "RequestAssociations": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["run_id", "evidence_hash"],
        "properties": {
          "run_id": {"type": "string"},
          "evidence_hash": {"type": "string"}
        }
      }
    },
    "RequestCandidateGeneration": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["run_id", "association_hash"],
        "properties": {
          "run_id": {"type": "string"},
          "association_hash": {"type": "string"}
        }
      }
    },
    "RequestIndependentEvaluation": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["run_id", "candidate_hash", "evidence_hash"],
        "properties": {
          "run_id": {"type": "string"},
          "candidate_hash": {"type": "string"},
          "evidence_hash": {"type": "string"}
        }
      }
    },
    "RequestRevision": {
      "kind": "command",
