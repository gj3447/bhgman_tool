  "safety_properties": [
    {
      "id": "propose-only-authority",
      "statement": "No transition emits ACCEPTED, mutates canon, materializes KG or source code, or removes the visible PROPOSED status.",
      "verification": "Static event and effect allowlist plus reducer conformance and forbidden-token contract tests."
    },
    {
      "id": "independent-hash-bound-verdict",
      "statement": "READY_TO_PROPOSE is reachable only from a receipt whose candidate and evidence hashes match context and whose evaluator identity family differs from the producer.",
      "verification": "evaluation_passes truth table, forged receipt fixtures, identity-collision cases, and production guard conformance."
    },
    {
      "id": "bounded-correction",
      "statement": "Correction cannot exceed configured rounds or hard budgets, and repeated semantic fingerprints terminate as PLATEAU rather than resetting progress.",
      "verification": "Property tests over correction sequences, budget monotonicity, semantic fingerprint repetition, and boundary values."
    },
    {
      "id": "exact-release-gate",
      "statement": "PublishProposedBundle is emitted only after exact-content approval and committed intent, and unknown outcomes cannot bypass reconciliation.",
      "verification": "Reachability check, approval mismatch fixtures, crash injection around intent and attempt, and destination receipt conformance."
    },
    {
      "id": "interrupt-safe-effects",
      "statement": "Cancellation, timeout, and budget exhaustion terminate immediately in safe states but are durably deferred across release intent, attempt, and reconciliation until the visible effect outcome is known.",
      "verification": "Every-state interrupt traces plus crash and duplicate delivery tests around the five effect-critical states."
    }
  ],
  "liveness_properties": [
    {
      "id": "bounded-creative-termination",
      "statement": "Every admitted run eventually reaches PROPOSED, REJECTED, PLATEAU, RETRY_EXHAUSTED, BUDGET_EXHAUSTED, TIMED_OUT, or CANCELED.",
      "assumptions": [
        "Each authorized port returns a recorded observation, a classified failure, or a deadline event within its per-call timeout.",
        "The external hard governor delivers TIMEOUT or BUDGET_EXHAUSTED when a hard boundary is reached.",
        "The correction-round and no-progress bounds are finite."
      ],
      "verification": "Bounded model check over state, correction round, retry count, and budget abstraction plus terminal-path trace coverage."
    },
    {
      "id": "eventual-release-reconciliation",
      "statement": "Once proposal release intent is committed, the run reaches a receipt or human reconciliation, then honors any pending interrupt before a terminal outcome.",
      "assumptions": [
        "The release adapter records each attempt without abandoning an in-flight visible effect.",
        "A destination receipt becomes inspectable or a human supplies ABANDON.",
        "The interrupt reconciler converts the durable ledger into exactly one pending-interrupt or no-pending event."
      ],
      "verification": "Crash traces before and after intent, attempt, receipt, and acknowledgement plus duplicate and reordered interrupt traces."
    }
  ],
